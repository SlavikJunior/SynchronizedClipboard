<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".SyncClipApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SynchronizedClipboard">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SynchronizedClipboard"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share Target: обработка ACTION_SEND text/plain -->
        <activity
            android:name="com.github.slavikjunior.synchronizedclipboard.feature.clipboard.impl.presentation.system.ShareActivity"
            android:exported="true"
            android:theme="@style/Theme.SyncClip.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Quick Settings Tile: прозрачная Activity для запуска из плитки -->
        <activity
            android:name="com.github.slavikjunior.synchronizedclipboard.feature.clipboard.impl.presentation.system.TileActionActivity"
            android:exported="false"
            android:theme="@style/Theme.SyncClip.Transparent"
            android:taskAffinity="" />

        <!-- Quick Settings Tile Service -->
        <service
            android:name="com.github.slavikjunior.synchronizedclipboard.feature.clipboard.impl.presentation.system.ClipboardTileService"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>